---
---

<button id="theme-toggle" aria-label="Pull cord to toggle light/dark">
  <span class="cord">
    <span class="cord-line"></span>
    <span class="cord-bead"></span>
  </span>
</button>

<style>
  #theme-toggle {
    position: fixed;
    z-index: 20;
    top: 0;
    left: 32px;
    width: 32px;
    height: 130px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    justify-content: center;
  }

  .cord {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateY(-50%);
  }

  .cord-line {
    width: 8px;
    height: 128px;
    background-image: radial-gradient(circle at 50% 35%, rgb(200, 200, 200), rgb(96, 96, 96) 65%, transparent 65%);
    background-size: 10px 6px;
    background-repeat: repeat-y;
    background-position: center top;
  }

  .cord-bead {
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #6b6864, #423f3a 55%, #232321 100%);
    box-shadow: 0 2px 3px rgba(0, 0, 0, 0.4);
    transition: background 0.4s ease;
  }

  :root[data-theme='light'] .cord-bead {
    background: radial-gradient(circle at 35% 30%, #8d8a84, #69645c 55%, #474742 100%);
  }

  @keyframes cord-tug {
    0% {
      transform: translateY(-50%);
    }
    30% {
      transform: translateY(calc(-50% + 10px));
    }
    55% {
      transform: translateY(calc(-50% + 8px));
    }
    75% {
      transform: translateY(calc(-50% - 4px));
    }
    100% {
      transform: translateY(-50%);
    }
  }

  .cord.tugging {
    animation: cord-tug 0.5s ease;
  }
</style>

<script is:inline>
  (function () {
    const button = document.getElementById('theme-toggle');
    const cord = button.querySelector('.cord');

    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}

      cord.classList.remove('tugging');
      void cord.offsetWidth;
      cord.classList.add('tugging');
    });

    cord.addEventListener('animationend', () => cord.classList.remove('tugging'));
  })();
</script>

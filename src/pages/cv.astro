---
import fs from 'node:fs';
import path from 'node:path';

const dir = path.resolve('./public/cs');
const pdf = fs.readdirSync(dir).find((f) => f.toLowerCase().endsWith('.pdf'));

if (!pdf) {
  throw new Error('No CV PDF found in public/cs');
}

const url = `/cs/${pdf}`;
---
<html>
  <head>
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <link rel="canonical" href={url} />
  </head>
  <body>
    <script set:html={`window.location.replace(${JSON.stringify(url)});`}></script>
  </body>
</html>

<div id="wood-background" aria-hidden="true">
  <div class="wood-base"></div>
  <div class="wood-dark-overlay"></div>
</div>

<style>
  #wood-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .wood-base,
  .wood-dark-overlay {
    position: absolute;
    inset: 0;
  }

  .wood-base {
    background:
      radial-gradient(circle 7vmax at 2% 1%, rgba(255, 248, 224, 0.95), transparent 100%),
      radial-gradient(circle 34vmax at 2% 1%, rgba(255, 225, 170, 0.55), rgba(255, 214, 140, 0.22) 40%, transparent 70%),
      repeating-linear-gradient(1deg, rgba(0, 0, 0, 0.06) 0px, transparent 1px, transparent 6px, rgba(255, 255, 255, 0.03) 7px, transparent 8px),
      repeating-linear-gradient(-1.5deg, rgba(0, 0, 0, 0.05) 0px, transparent 2px, transparent 15px),
      linear-gradient(160deg, #9c7950, #785530 55%, #634427);
  }

  .wood-dark-overlay {
    opacity: 0;
    transition: opacity 0.5s ease;
    background:
      repeating-linear-gradient(1deg, rgba(0, 0, 0, 0.16) 0px, transparent 1px, transparent 6px, rgba(255, 255, 255, 0.012) 7px, transparent 8px),
      repeating-linear-gradient(-1.5deg, rgba(0, 0, 0, 0.14) 0px, transparent 2px, transparent 15px),
      linear-gradient(160deg, #1c1208, #130c05, #0a0603);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .wood-dark-overlay {
      opacity: 1;
    }
  }

  :root[data-theme='dark'] .wood-dark-overlay {
    opacity: 1;
  }
</style>

---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = async () => {
  const langs = Object.keys(ui);

  return langs.map((lang) => ({
    params: { lang }
  }));
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <section id="home">
    <h1>Václav Parma</h1>
    <p>{t("home_subtitle")}</p>
  </section>
  <section id="about">
    <div class="section-heading"><h2>{t("about_title")}</h2></div>
    <p>{t('about_1a')}<span id="age">-years-</span>{t('about_1b')}</p>
    <p>{t('about_2')}</p>
    <p>{t('about_3')}</p>
  </section>
  <section id="contact">
    <div class="section-heading"><h2>{t("contact_title")}</h2></div>
    <div class="contact-row">
      <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 6.223-8-6.222V6h16zM4 18V9.044l7.386 5.745a.994.994 0 0 0 1.228 0L20 9.044 20.002 18H4z"/></svg>
      <span class="contact-label">{t("contact_email_label")}:</span>
      <a class="contact-value" href={`mailto:${t("contact_email")}`}>{t("contact_email")}</a>
    </div>
    <div class="contact-row">
      <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><circle cx="4.983" cy="5.009" r="2.188"></circle><path d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z"></path></svg>
      <span class="contact-label">LinkedIn:</span>
      <a class="contact-value" href="https://linkedin.com/in/vaclavparma" target="_blank">https://linkedin.com/in/vaclavparma</a>
    </div>
    <div class="contact-row">
      <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"></path></svg>
      <span class="contact-label">GitHub:</span>
      <a class="contact-value" href="https://github.com/vaclavparma" target="_blank">https://github.com/vaclavparma</a>
    </div>
  </section>
</Layout>

<style>
  section {
    width: 50%;
    margin: auto;
  }

  section p {
    font-weight: 200;
    letter-spacing: 1px;
    line-height: 1.25;
  }

  .section-heading {
    width: 100%;
    text-align: center;
    border-bottom: 3px solid #7871aa;
    margin-bottom: 32px;
  }

  .section-heading h2 {
    margin: 0 0 6px 0;
    font-size: 32px;
    font-weight: 300;
    letter-spacing: 2px;
  }

  #home {
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  #home h1 {
    margin: 0;
    font-size: 97px;
    font-weight: 100;
    letter-spacing: 6px;
  }

  #home p {
    margin: 0 0 28px 0;
    font-size: 28px;
    font-weight: 100;
    letter-spacing: 2px;
    color: #aeaeae;
  }

  #about {
    margin-top: 50vh;
    height: 125vh;
  }

  #about p {
    text-align: justify;
    font-size: 20px;
  }

  #age {
    font-family: "Lucida Console", "Courier New", monospace;
    font-weight: 400;
    letter-spacing: -1px;
    position: relative;
  }

  #contact {
    height: 100vh;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0 0 0;
    font-size: 20px;
    font-weight: 200;
    color: #fff;
  }

  .contact-icon {
    fill: #e0e0e0;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
  }

  .contact-label {
    margin-right: 4px;
    font-size: 20px;
    font-weight: 200;
    color: #fff;
    opacity: 0.8;
  }

  .contact-value {
    color: #fff;
    text-decoration: underline dotted;
    font-size: 20px;
    font-weight: 200;
    transition: color 0.2s;
  }
  
  .contact-value:hover {
    color: #959595;
    text-decoration: underline dashed;
  }
  @media (max-width: 900px) {
    section {
      width: 80%;
    }
    #home h1 {
      font-size: 64px;
    }
    #home p {
      font-size: 22px;
    }
    .section-heading h2 {
      font-size: 26px;
    }
    #about p {
      font-size: 17px;
    }
    .contact-row {
      font-size: 17px;
    }
    .contact-label, .contact-value {
      font-size: 17px;
    }
  }

  @media (max-width: 600px) {
    #home h1 {
      font-size: 38px;
      letter-spacing: 2px;
    }
    #home p {
      font-size: 14px;
      letter-spacing: 1px;
    }
    .section-heading h2 {
      font-size: 18px;
      letter-spacing: 1px;
    }
    #about {
      margin-top: 25vh;
    }
    #about p {
      font-size: 14px;
    }
    .contact-row {
      font-size: 14px;
      gap: 8px;
    }
    .contact-label {
      font-size: 14px;
    }
    .contact-value {
      font-size: 10px;
    }
    .contact-icon {
      width: 18px;
      height: 18px;
    }
  }
</style>

<script lang="js">
  document.addEventListener("DOMContentLoaded", function () {
    setInterval(() => {
      const date_fix = 0.002819741;
      const startDate = new Date("2006/02/08");
      const diffDate = new Date(new Date() - startDate);
      my_age =
        diffDate.toISOString().slice(0, 4) -
        1970 +
        diffDate.getMonth() / 12 +
        (diffDate.getDate() - 1) / 365.25 +
        diffDate.getHours() / 8760 +
        diffDate.getMinutes() / 525600 +
        diffDate.getSeconds() / 31536000 +
        diffDate.getMilliseconds() / 31536000000;
      my_age = Math.round((my_age - date_fix) * 10000000000) / 10000000000;
      my_age = my_age.toFixed(10);
      const element = document.getElementById("age");
      element.textContent = my_age;
    }, 100);
  });
</script>

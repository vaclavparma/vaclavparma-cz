---
import fs from 'node:fs';
import path from 'node:path';
import { ui } from '../../i18n/ui';

export const getStaticPaths = () => {
  return Object.keys(ui).map((lang) => {
    const dir = path.resolve(`./public/${lang}`);
    const pdf = fs.readdirSync(dir).find((f) => f.toLowerCase().endsWith('.pdf'));
    if (!pdf) {
      throw new Error(`No CV PDF found in public/${lang}`);
    }
    return { params: { lang }, props: { url: `/${lang}/${pdf}` } };
  });
};

const { url } = Astro.props;
---
<html>
  <head>
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <link rel="canonical" href={url} />
  </head>
  <body>
    <script set:html={`window.location.replace(${JSON.stringify(url)});`}></script>
  </body>
</html>
